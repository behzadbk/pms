# --- Postgres محلی (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pms
POSTGRES_PORT=5432

# --- رمز نقش‌های اپلیکیشن (migrate.sh با ALTER ROLE اعمال می‌کند) ---
APP_USER_PASSWORD=app_user_change_me
PLATFORM_ADMIN_PASSWORD=platform_admin_change_me

# --- رشته اتصالی که سرویس‌های NestJS باید بگیرند (نقش app_user، نه postgres) ---
# DATABASE_URL=postgres://app_user:app_user_change_me@localhost:5432/pms
