// این فایل مرجع مستندسازی مدل داده identity-svc است (بخش ۲ سند SPEC.md / ARCHITECTURE-SAAS.md).
// در این نسخه دمو، DatabaseService از `pg` مستقیم استفاده می‌کند (به‌دلیل محدودیت دانلود
// Prisma Engine در محیط sandbox این تحویل)؛ در Production واقعی این schema با
// `npx prisma generate` و `npx prisma migrate deploy` مدیریت می‌شود — منطق RLS
// (فایل migrations/001_enable_rls.sql) مستقل از این انتخاب و در هر دو حالت یکسان اجرا می‌شود.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  status    String   @default("trial") // active | trial | suspended | cancelled
  planId    String?  @map("plan_id")
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  // --- سطح سرویس (migration 002) — ساده | اقتصادی | حرفه‌ای ---
  tier        String  @default("simple") // simple | economic | professional
  unitCount   Int     @default(0) @map("unit_count")
  floorCount  Int?    @map("floor_count")
  address     String?
  managerName  String? @map("manager_name")
  managerPhone String? @map("manager_phone")

  // --- تسویه اشتراک با پلتفرم (وضعیت مالی در پنل سوپرادمین) ---
  monthlyFee        BigInt   @default(0) @map("monthly_fee")
  outstandingAmount BigInt   @default(0) @map("outstanding_amount")
  billingStatus     String   @default("settled") @map("billing_status") // settled | due | overdue
  lastPaymentAt     DateTime? @map("last_payment_at") @db.Date
  nextDueAt         DateTime? @map("next_due_at") @db.Date

  @@map("tenants")
  @@schema("identity")
}

/// کاربران سطح پلتفرم (سوپرادمین) — به هیچ tenant‌ای تعلق ندارند و این جدول
/// عمداً RLS ندارد؛ توکن صادرشده برای آن‌ها tenant_id = null دارد.
model PlatformAdmin {
  id           String    @id @default(uuid())
  username     String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("platform_admins")
  @@schema("identity")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  fullName     String   @map("full_name")
  email        String
  passwordHash String   @map("password_hash")
  role         String   // admin | resident | guard | staff | accountant
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email])
  @@map("users")
  @@schema("identity")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)

  @@map("refresh_tokens")
  @@schema("identity")
}
