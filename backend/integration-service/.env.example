PORT=3009
DATABASE_URL=postgresql://app_user:CHANGE_ME@postgres:5432/pms
JWT_SECRET=CHANGE_ME_32_CHAR_MINIMUM_RANDOM_SECRET
# فاصله‌ی بررسی صف ارسال به ERP (ثانیه) — 0 = ارسال خودکار خاموش
ERP_DISPATCH_INTERVAL_SEC=15
# اجازه‌ی URL غیر https / شبکه‌ی داخلی برای connector (فقط توسعه؛ در production همیشه false)
ERP_ALLOW_INSECURE_URLS=false
