# ─────────────────────────────────────────────────────────────
#  تنظیمات اجرای کامل با Docker Compose (docker-compose.yml)
#  install.sh این فایل را خودکار با رمزهای تصادفی به‌صورت .env می‌سازد؛
#  این نمونه فقط برای مستندسازی است. .env را هرگز commit نکنید.
# ─────────────────────────────────────────────────────────────

# آدرس عمومی سامانه (برای CORS و نمایش در پایان نصب)
PUBLIC_URL=http://YOUR_SERVER_IP
# پورت gateway روی سرور
HTTP_PORT=80

# رمزهای زیرساخت — هرکدام یک رشته‌ی تصادفی طولانی
POSTGRES_PASSWORD=CHANGE_ME
APP_USER_PASSWORD=CHANGE_ME
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
RABBITMQ_USER=pms
RABBITMQ_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# کاربر سوپرادمین پنل /super-admin/login (با هر install/update ساخته یا به‌روز می‌شود)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=CHANGE_ME

# اختیاری
VITE_VAPID_PUBLIC_KEY=
REGISTRY_MIRROR=
NPM_REGISTRY=
